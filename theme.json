{
    "$schema": "https://wp.org",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "680px",
            "wideSize": "1200px"
        },
        "color": {
            "palette": [
                {
                    "slug": "base",
                    "color": "#ffffff",
                    "name": "Base White"
                },
                {
                    "slug": "contrast",
                    "color": "#111111",
                    "name": "Contrast Dark"
                },
                {
                    "slug": "primary",
                    "color": "#0073aa",
                    "name": "Primary Blue"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        }
    }
}
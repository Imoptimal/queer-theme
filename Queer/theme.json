{
	"$schema": "https://wp.org",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "hdr-ftr-color", "color": "#181b22", "name": "Header/footer Background Color" },
				{ "slug": "text-color", "color": "#f7f7f7", "name": "Normal Text Color" },
				{ "slug": "bg-color", "color": "#1E222B", "name": "Background Color for All Other Elements" },
				{ "slug": "dark-shade", "color": "#a71616", "name": "Default Darker Red Shade" }
			]
		}
	},
	"typography": {
		"fontSizes": [
			{
				"slug": "small",
				"size": "12px",
				"name": "Small (Minimum)"
			},
			{
				"slug": "medium",
				"size": "16px",
				"name": "Medium (Default)"
			},
			{
				"slug": "large",
				"size": "20px",
				"name": "Large"
			}
		]
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg-color)",
			"text": "var(--wp--preset--color--text-color)"
		},
		"typography": {
      		"lineHeight": "1.75",
      		"fontSize": "var(--wp--preset--font-size--medium)"
    	},
		"elements": {
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "2" }
			},
			"link": {
				"color": { 
				"text": "var(--wp--preset--color--link-color)" 
			},
			"typography": {
				"textShadow": "2px 0 var(--wp--preset--color--dark-shade), -2px 0 var(--wp--preset--color--dark-shade), 0 2px var(--wp--preset--color--dark-shade), 0 -2px var(--wp--preset--color--dark-shade), 1px 1px var(--wp--preset--color--dark-shade), -1px -1px var(--wp--preset--color--dark-shade), 1px -1px var(--wp--preset--color--dark-shade), -1px 1px var(--wp--preset--color--dark-shade)"
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--text-color)",
					"text": "var(--wp--preset--color--red-bg)"
				},
				"spacing": { "padding": { "top": "15px", "bottom": "5px", "left": "5px", "right": "5px" } }
				}
			}
		}
	}
}